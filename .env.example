# Gemini (Google AI Studio)
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash-lite
# GEMINI_TEXT_MODEL=

# Google Programmable Search (restricted to curated volunteer sites)
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Supabase (service-role key: the backend enforces per-user access)
SUPABASE_URL=
SUPABASE_KEY=

# Clerk: https://<your-frontend-api>/.well-known/jwks.json (Clerk dashboard -> API keys)
CLERK_JWKS_URL=

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
